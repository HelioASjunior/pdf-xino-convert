{
  "name": "pdf-xinoconvert",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "build:pages": "npm run build -w frontend",
    "preview:frontend": "npm --workspace frontend run preview -- --strictPort",
    "preview:frontend:auto": "npm --workspace frontend run preview --",
    "preview:pages": "npm run preview:frontend --",
    "preview:pages:auto": "npm run preview:frontend:auto --",
    "kill:port": "node scripts/kill-port.mjs",
    "kill:4173": "node scripts/kill-port.mjs 4173",
    "preview:pages:kill": "npm run kill:4173 && npm run preview:pages --",
    "qa:assets": "node scripts/generate-qa-assets.mjs",
    "port:4173": "node scripts/inspect-port.mjs 4173",
    "test:xlsx-pdf": "npm run qa:assets && node scripts/test-xlsx-to-pdf.mjs"
  }
}
